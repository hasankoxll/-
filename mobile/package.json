{
  "name": "vaultify-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate": "npm run typecheck && npm run lint && npx expo-doctor@latest",
    "eas:dev:ios": "eas build --platform ios --profile development",
    "eas:dev:android": "eas build --platform android --profile development",
    "eas:preview:ios": "eas build --platform ios --profile preview",
    "eas:preview:android": "eas build --platform android --profile preview",
    "eas:production:ios": "eas build --platform ios --profile production",
    "eas:production:android": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "expo": "latest",
    "expo-constants": "latest",
    "expo-dev-client": "latest",
    "expo-linking": "latest",
    "expo-router": "latest",
    "expo-secure-store": "latest",
    "expo-status-bar": "latest",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "eslint": "latest",
    "eslint-config-expo": "latest",
    "typescript": "^6.0.0"
  }
}
